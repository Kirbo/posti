{
  "name": "posti",
  "version": "4.0.0",
  "description": "Finnish postal data (BAF/PCF/POM) loader for PostgreSQL, MySQL, MariaDB, and SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "posti": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "dev": "tsx --watch src/cli.ts",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "format": "biome format --write src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "deps:check": "pnpm outdated && pnpm audit",
    "deps:update": "pnpm update --latest && pnpm install"
  },
  "keywords": [
    "posti",
    "finnish post",
    "postal codes",
    "addresses",
    "postgresql",
    "mysql",
    "mariadb",
    "sqlite",
    "cli"
  ],
  "repository": "https://github.com/kirbo/posti",
  "author": "Kimmo Saari <kirbo@kirbo-designs.com>",
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "iconv-lite": "^0.7.3",
    "picocolors": "^1.1.1",
    "unzipper": "^0.12.5",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/cli-progress": "3.11.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/unzipper": "0.10.11",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
