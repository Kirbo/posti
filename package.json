{
  "name": "posti",
  "version": "4.0.0",
  "description": "Finnish postal data (BAF/PCF/POM) loader for MySQL, MariaDB, PostgreSQL, and SQLite",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "posti": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "dev": "tsx --watch src/cli.ts",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "format": "biome format --write src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "deps:check": "pnpm outdated && pnpm audit",
    "deps:update": "pnpm update --latest && pnpm install"
  },
  "keywords": [
    "posti",
    "finnish post",
    "postal codes",
    "addresses",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "cli"
  ],
  "repository": "https://github.com/kirbo/posti",
  "author": "Kimmo Saari <kirbo@kirbo-designs.com>",
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "iconv-lite": "^0.7.2",
    "picocolors": "^1.1.1",
    "unzipper": "^0.12.3",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.8.0",
    "mysql2": "^3.23.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
